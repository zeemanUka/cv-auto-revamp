GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
# Docker Postgres settings
POSTGRES_DB=cv_revamp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Local default (sqlite). Docker compose overrides this with Postgres URL.
DATABASE_URL=sqlite:///./cv_app.db
FILES_ROOT=files
# Optional: override Gemini API base URL and version if needed
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta
